[Unit]
Description=MSP 에이전트 (읽기 전용 수집)
After=network.target msp-central.service

[Service]
Slice=msp.slice
User=msp-agent
Group=msp-agent
# docker는 소켓 읽기에, adm은 nginx 접근 로그 읽기에, tty는 콘솔 글자 화면 읽기에 필요하다.
# Docker 클라이언트는 GET과 허용 경로 외의 요청을 보내지 않는다.
SupplementaryGroups=docker adm tty
# adm 그룹은 시스템 로그 전체를 읽을 수 있으므로 /var/log에서 nginx 로그만 보이게 한다.
TemporaryFileSystem=/var/log:ro
BindReadOnlyPaths=-/var/log/nginx
StateDirectory=msp-agent
StateDirectoryMode=0700
Environment=GOMEMLIMIT=64MiB
Environment=GOMAXPROCS=1
ExecStart=/opt/msp/msp-agent --config /etc/msp/agent.json
Restart=always
RestartSec=10
CPUQuota=10%
UMask=0077

# 다른 프로세스의 /proc를 읽어야 하므로 ProtectProc과 ProcSubset은 쓰지 않는다.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# 장치는 콘솔 글자 화면(vcs)만 읽기 전용으로 연다. 터미널 장치는 열 수 없어 입력을 보낼 수 없다.
DevicePolicy=closed
DeviceAllow=char-vcs r
# tty 그룹은 다른 사용자의 터미널 창에 글자를 쓸 수 있다. 그 길을 막는다.
InaccessiblePaths=-/dev/pts
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
